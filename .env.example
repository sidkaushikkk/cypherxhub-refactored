# CypherX Backend Environment Configuration Example
# Copy to .env and populate with your actual keys and configuration

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Security & Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SCAN_RATE_LIMIT_MAX=30

# Threat Intelligence APIs
# NOTE: If your Google Safe Browsing API key was previously committed to git history,
# treat it as compromised and revoke/rotate it in Google Cloud Console!
GOOGLE_SAFE_BROWSING_API_KEY=
